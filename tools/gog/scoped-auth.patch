+package cmd
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/steipete/gogcli/internal/app"
+	"github.com/steipete/gogcli/internal/secrets"
+)
+
+// All other Store methods intentionally panic through the nil embedding: a
+// list, default lookup, migrating read, write or delete must fail this fixture.
+type inspectAccountFixtureStore struct {
+	secrets.Store
+	requested [][2]string
+	token     secrets.Token
+	err       error
+}
+
+func (s *inspectAccountFixtureStore) GetTokenNoMigrate(client, email string) (secrets.Token, error) {
+	s.requested = append(s.requested, [2]string{client, email})
+	return s.token, s.err
+}
+
+func TestJobTrackInspectAccountReadsOnlyExplicitAccountAndEmitsMetadata(t *testing.T) {
+	store := &inspectAccountFixtureStore{token: secrets.Token{
+		Email: "worker@example.com", Client: "default", Services: []string{"gmail"},
+		Scopes:       []string{"https://www.googleapis.com/auth/gmail.send"},
+		RefreshToken: "fixture-secret-refresh", AccessToken: "fixture-secret-access", Subject: "fixture-subject",
+	}}
+	var stdout, stderr bytes.Buffer
+	ctx := withAuthStore(newCmdRuntimeJSONOutputContext(t, &stdout, &stderr), store)
+	if err := (&AuthInspectAccountCmd{Email: "worker@example.com"}).Run(ctx, &RootFlags{Client: "default", Account: "worker@example.com"}); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(store.requested, [][2]string{{"default", "worker@example.com"}}) {
+		t.Fatalf("unexpected account reads: %v", store.requested)
+	}
+	var output map[string]any
+	if err := json.Unmarshal(stdout.Bytes(), &output); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{"schemaVersion": "jobtrack-gog-account-metadata.v1", "email": "worker@example.com", "client": "default",
+		"services": []any{"gmail"}, "scopes": []any{"https://www.googleapis.com/auth/gmail.send"}, "auth": "oauth", "credentialValuesIncluded": false}
+	if !reflect.DeepEqual(output, want) {
+		t.Fatal("metadata shape or readiness evidence changed")
+	}
+	if strings.Contains(stdout.String()+stderr.String(), "fixture-secret") || strings.Contains(stdout.String(), "fixture-subject") {
+		t.Fatal("credential or unnecessary identity field reached output")
+	}
+}
+
+func TestJobTrackInspectAccountRejectsImplicitOrConflictingSelectorsBeforeOpeningStore(t *testing.T) {
+	for _, tc := range []struct {
+		email string
+		flags *RootFlags
+	}{
+		{"", &RootFlags{Client: "default"}}, {"auto", &RootFlags{Client: "default"}},
+		{"alias", &RootFlags{Client: "default"}}, {"Name <worker@example.com>", &RootFlags{Client: "default"}},
+		{"worker@example.com", nil}, {"worker@example.com", &RootFlags{}},
+		{"worker@example.com", &RootFlags{Client: "../other"}},
+		{"worker@example.com", &RootFlags{Client: "default", Account: "other@example.com"}},
+	} {
+		ctx := withAuthOperations(newCmdRuntimeJSONOutputContext(t, io.Discard, io.Discard), app.AuthOperations{
+			OpenSecretsStore: func() (secrets.Store, error) { t.Fatal("invalid selection opened credential store"); return nil, nil },
+		})
+		if err := (&AuthInspectAccountCmd{Email: tc.email}).Run(ctx, tc.flags); err == nil {
+			t.Fatal("invalid or conflicting selectors were accepted")
+		}
+	}
+}
+
+func TestJobTrackInspectAccountRefusesFallbackErrorsAndIdentityMismatch(t *testing.T) {
+	for _, store := range []secrets.Store{
+		newMemSecretsStore(), // Implements GetToken, but not GetTokenNoMigrate.
+		&inspectAccountFixtureStore{err: errors.New("fixture-secret-error-must-not-be-exported")},
+		&inspectAccountFixtureStore{token: secrets.Token{Email: "other@example.com", Client: "default"}},
+		&inspectAccountFixtureStore{token: secrets.Token{Email: "worker@example.com", Client: "other"}},
+	} {
+		var stdout, stderr bytes.Buffer
+		ctx := withAuthStore(newCmdRuntimeJSONOutputContext(t, &stdout, &stderr), store)
+		err := (&AuthInspectAccountCmd{Email: "worker@example.com"}).Run(ctx, &RootFlags{Client: "default"})
+		if err == nil || strings.Contains(err.Error(), "fixture-secret") || stdout.Len() != 0 || stderr.Len() != 0 {
+			t.Fatal("inspection did not fail closed without credential output")
+		}
+	}
+}
+
+func TestJobTrackInspectAccountRealCommandRouting(t *testing.T) {
+	store := &inspectAccountFixtureStore{token: secrets.Token{Email: "worker@example.com", Client: "default"}}
+	runtime := runtimeWithAuthStore(store)
+	output := captureStdout(t, func() {
+		_ = captureStderr(t, func() {
+			if err := executeWithRuntime([]string{"--json", "--client=default", "--account=worker@example.com", "auth", "inspect-account", "worker@example.com"}, runtime); err != nil {
+				t.Fatal(err)
+			}
+		})
+	})
+	if len(store.requested) != 1 || !strings.Contains(output, `"schemaVersion": "jobtrack-gog-account-metadata.v1"`) {
+		t.Fatal("real CLI failed to route the scoped inspection")
+	}
+}
