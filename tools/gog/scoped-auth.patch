index 0000000..e1c2251
--- /dev/null
+++ b/internal/cmd/auth_inspect_account.go
@@ -0,0 +1,68 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"net/mail"
+	"strings"
+
+	"github.com/steipete/gogcli/internal/config"
+	"github.com/steipete/gogcli/internal/outfmt"
+)
+
+// AuthInspectAccountCmd is a JobTrack-specific, read-only metadata boundary.
+// An explicit address and client are required; defaults, account aliases and
+// account enumeration cannot select another credential behind the caller.
+type AuthInspectAccountCmd struct {
+	Email string `arg:"" name:"email" help:"Exact account email (not an alias or auto)"`
+}
+
+type authInspectAccountMetadata struct {
+	SchemaVersion            string   `json:"schemaVersion"`
+	Email                    string   `json:"email"`
+	Client                   string   `json:"client"`
+	Services                 []string `json:"services"`
+	Scopes                   []string `json:"scopes"`
+	Auth                     string   `json:"auth"`
+	CredentialValuesIncluded bool     `json:"credentialValuesIncluded"`
+}
+
+func (c *AuthInspectAccountCmd) Run(ctx context.Context, flags *RootFlags) error {
+	email := normalizeEmail(c.Email)
+	address, err := mail.ParseAddress(email)
+	if err != nil || len(email) > 320 || address.Address != email || flags == nil || strings.TrimSpace(flags.Client) == "" {
+		return usage("inspect-account requires an exact email and explicit --client")
+	}
+	if flags.Account != "" && normalizeEmail(flags.Account) != email {
+		return usage("inspect-account email and --account must match exactly")
+	}
+	client, err := config.NormalizeClientName(flags.Client)
+	if err != nil {
+		return usage("inspect-account requires a valid explicit --client")
+	}
+	store, err := openAuthSecretsStore(ctx)
+	if err != nil {
+		return errors.New("jobtrack: scoped account metadata store unavailable")
+	}
+	reader, ok := store.(tokenNoMigrateGetter)
+	if !ok {
+		// Never fall back to GetToken: it may migrate aliases while reading.
+		return errors.New("jobtrack: scoped non-migrating account inspection unavailable")
+	}
+	tok, err := reader.GetTokenNoMigrate(client, email)
+	if err != nil {
+		return errors.New("jobtrack: scoped stored account unavailable")
+	}
+	if normalizeEmail(tok.Email) != email || tok.Client != client {
+		return errors.New("jobtrack: scoped stored account identity mismatch")
+	}
+	// Copy only the metadata fields explicitly needed for readiness. Never pass
+	// a Token or map derived from its serialization to the output formatter.
+	return outfmt.WriteJSON(ctx, stdoutWriter(ctx), authInspectAccountMetadata{
+		SchemaVersion: "jobtrack-gog-account-metadata.v1",
+		Email:         email, Client: client,
+		Services: append([]string{}, tok.Services...),
+		Scopes:   append([]string{}, tok.Scopes...),
+		Auth:     authTypeOAuth, CredentialValuesIncluded: false,
+	})
+}
