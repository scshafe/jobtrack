@@ -0,0 +1,37 @@
+//go:build darwin && cgo
+
+package cmd
+
+import (
+	"io"
+	"os"
+	"os/exec"
+	"testing"
+)
+
+func TestJobTrackNoninteractiveKeychainNativeChild(t *testing.T) {
+	const childMarker = "JOBTRACK_GOG_NATIVE_UI_POLICY_TEST"
+	if os.Getenv(childMarker) == "1" {
+		// Real parser -> real native Set(false) -> Get(false) verification.
+		// No command Run(), store, credential, Keychain item, or provider call.
+		parser, _, err := newParserWithWriters("native policy fixture", io.Discard, io.Discard)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := parser.Parse([]string{"--no-input", "version"}); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(executable, "-test.run=^TestJobTrackNoninteractiveKeychainNativeChild$")
+	// No inherited credential variables or config selectors. This policy change
+	// exists only inside the disposable child, not the parent test process.
+	child.Env = []string{childMarker + "=1"}
+	if output, err := child.CombinedOutput(); err != nil {
+		t.Fatalf("native noninteractive policy child failed: %v: %s", err, output)
+	}
+}
