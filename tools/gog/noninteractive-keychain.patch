@@ -0,0 +1,117 @@
+package cmd
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/steipete/gogcli/internal/app"
+	"github.com/steipete/gogcli/internal/secrets"
+)
+
+func TestJobTrackNoninteractiveKeychainFlagAliasesAndForegroundDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		args []string
+		want int
+	}{
+		{[]string{"version"}, 0}, {[]string{"--no-input=false", "version"}, 0},
+		{[]string{"--no-input", "version"}, 1}, {[]string{"--no-input=true", "version"}, 1},
+		{[]string{"--non-interactive", "version"}, 1}, {[]string{"--noninteractive", "version"}, 1},
+		{[]string{"version", "--no-input"}, 1}, {[]string{"--noninteractive=false", "version"}, 0},
+		{[]string{"--no-input", "gmail", "labels", "list"}, 1},
+		{[]string{"gmail", "labels", "list", "--non-interactive"}, 1},
+		{[]string{"--no-input", "calendar", "colors"}, 1},
+		{[]string{"--no-input", "drive", "ls"}, 1},
+	} {
+		t.Run(strings.Join(tc.args, " "), func(t *testing.T) {
+			parser, cli, err := newParserWithWriters("fixture", io.Discard, io.Discard)
+			if err != nil {
+				t.Fatal(err)
+			}
+			calls := 0
+			cli.keychainUI = func() error { calls++; return nil }
+			if _, err := parser.Parse(tc.args); err != nil {
+				t.Fatal(err)
+			}
+			if calls != tc.want {
+				t.Fatalf("native policy calls=%d, want %d", calls, tc.want)
+			}
+		})
+	}
+}
+
+func TestJobTrackNoninteractiveKeychainFailureStopsGmailBeforeRun(t *testing.T) {
+	parser, cli, err := newParserWithWriters("fixture", io.Discard, io.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	cli.keychainUI = func() error { calls++; return errors.New("native-detail-must-not-escape") }
+	parsed, err := parser.Parse([]string{"--no-input", "--account=worker@example.com", "gmail", "labels", "list"})
+	if err == nil || parsed != nil || calls != 1 || strings.Contains(err.Error(), "native-detail") {
+		t.Fatal("Gmail parsing did not fail closed before Run on native policy failure")
+	}
+}
+
+func TestJobTrackNoninteractiveKeychainFencePrecedesCredentialAccess(t *testing.T) {
+	for _, failPolicy := range []bool{false, true} {
+		var stdout, stderr bytes.Buffer
+		parser, cli, err := newParserWithWriters("fixture", &stdout, &stderr)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var events []string
+		cli.keychainUI = func() error {
+			events = append(events, "disable-ui")
+			if failPolicy {
+				return errors.New("native-diagnostic-must-not-escape")
+			}
+			return nil
+		}
+		parsed, err := parser.Parse([]string{"--no-input", "--client=default", "--json", "auth", "inspect-account", "worker@example.com"})
+		if failPolicy {
+			if err == nil || strings.Contains(err.Error(), "native-diagnostic") || !reflect.DeepEqual(events, []string{"disable-ui"}) {
+				t.Fatal("native policy failure did not stop parsing with an opaque error")
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		store := &inspectAccountFixtureStore{token: secrets.Token{Email: "worker@example.com", Client: "default"}}
+		ctx := withAuthOperations(newCmdRuntimeJSONOutputContext(t, &stdout, &stderr), app.AuthOperations{
+			OpenSecretsStore: func() (secrets.Store, error) {
+				events = append(events, "open-credential-store")
+				return store, nil
+			},
+		})
+		parsed.BindTo(ctx, (*context.Context)(nil))
+		if err := parsed.Run(&cli.RootFlags); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(events, []string{"disable-ui", "open-credential-store"}) || len(store.requested) != 1 {
+			t.Fatal("credential access did not follow the native prompt fence exactly once")
+		}
+	}
+}
+
+func TestJobTrackNoninteractiveKeychainDoesNotReenableAfterLaterInteractiveParse(t *testing.T) {
+	parser, cli, err := newParserWithWriters("fixture", io.Discard, io.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	cli.keychainUI = func() error { calls++; return nil }
+	for _, args := range [][]string{{"--no-input", "version"}, {"version"}} {
+		if _, err := parser.Parse(args); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if calls != 1 {
+		t.Fatal("later parse attempted another native policy change")
+	}
+}
