+
+package cmd
+
+// A non-CGO macOS build cannot guarantee the advertised native prompt fence.
+// Refuse before credential access rather than silently degrade --no-input.
+func disableNativeKeychainInteraction() error { return errNoninteractiveKeychainPolicy }
