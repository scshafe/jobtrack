new file mode 100644
index 0000000..974de17
--- /dev/null
+++ b/internal/cmd/keychain_noninteractive.go
@@ -0,0 +1,37 @@
+package cmd
+
+import (
+	"errors"
+
+	"github.com/alecthomas/kong"
+)
+
+var errNoninteractiveKeychainPolicy = errors.New("jobtrack: noninteractive Keychain policy unavailable")
+
+// BeforeApply runs after Kong has resolved flags, but before command execution
+// or account/client credential lookup. NoInput alone previously suppressed CLI
+// prompts, not Security.framework dialogs. This process-local fence never
+// authorizes, unlocks, repairs, or changes permissions on any Keychain item.
+func (f *CLI) BeforeApply(ctx *kong.Context) error {
+	for _, flag := range ctx.Model.Flags {
+		if flag.Name != "no-input" {
+			continue
+		}
+		noInput, ok := ctx.FlagValue(flag).(bool)
+		if !ok {
+			return errNoninteractiveKeychainPolicy
+		}
+		if !noInput {
+			return nil // Never re-enable interaction or change foreground defaults.
+		}
+		disable := f.keychainUI
+		if disable == nil {
+			disable = disableNativeKeychainInteraction
+		}
+		if err := disable(); err != nil {
+			return errNoninteractiveKeychainPolicy // Do not expose native diagnostics.
+		}
+		return nil
+	}
+	return errNoninteractiveKeychainPolicy
+}
diff --git a/internal/cmd/keychain_noninteractive_darwin.go b/internal/cmd/keychain_noninteractive_darwin.go
new file mode 100644
index 0000000..2107609
--- /dev/null
+++ b/internal/cmd/keychain_noninteractive_darwin.go
@@ -0,0 +1,22 @@
+//go:build darwin && cgo
+
+package cmd
+
+/*
+#cgo LDFLAGS: -framework Security
+#include <Security/SecKeychain.h>
+*/
+import "C"
+
+// Security.framework's interaction policy applies only to this gog process.
+// This does not edit ACLs, unlock a Keychain, or suppress another application's UI.
+func disableNativeKeychainInteraction() error {
+	if C.SecKeychainSetUserInteractionAllowed(C.Boolean(0)) != C.errSecSuccess {
+		return errNoninteractiveKeychainPolicy
+	}
+	var allowed C.Boolean
+	if C.SecKeychainGetUserInteractionAllowed(&allowed) != C.errSecSuccess || allowed != 0 {
+		return errNoninteractiveKeychainPolicy
+	}
+	return nil
+}
