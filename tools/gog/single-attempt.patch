@@ -11,6 +11,7 @@ import (
 	"math/big"
 	"net/http"
 	"strconv"
+	"strings"
 	"time"
 )
 
@@ -49,6 +50,39 @@ func (t *RetryTransport) RoundTrip(req *http.Request) (*http.Response, error) {
 		return nil, &CircuitBreakerError{}
 	}
 
+	// JobTrack's approved mutations are physically single-attempt. A 429,
+	// 5xx, disconnect, or redirect does not prove that no mutation occurred.
+	// Keep read retries, but remove replay hooks before both OAuth and Go's
+	// HTTP/1 and HTTP/2 transports see a non-read request.
+	if req.Method != http.MethodGet && req.Method != http.MethodHead && req.Method != http.MethodOptions {
+		for name := range req.Header {
+			if strings.EqualFold(name, "Idempotency-Key") || strings.EqualFold(name, "X-Idempotency-Key") {
+				if req.Body != nil {
+					_ = req.Body.Close()
+				}
+				return nil, errors.New("jobtrack: mutation replay header refused")
+			}
+		}
+		once := req.Clone(req.Context())
+		once.GetBody = nil
+		if once.Body == nil || once.Body == http.NoBody {
+			// HTTP/2 may retry requests with a nil/NoBody regardless of method.
+			// Preserve empty bytes without exposing that replay shortcut.
+			once.Body = io.NopCloser(bytes.NewReader(nil))
+		}
+		resp, err := t.Base.RoundTrip(once)
+		if err != nil {
+			return nil, fmt.Errorf("single-attempt mutation: %w", err)
+		}
+		// Reject here, before http.Client can use the original request's
+		// GetBody for 307/308 or turn a 301/302/303 into another request.
+		if resp.StatusCode >= 300 && resp.StatusCode < 400 {
+			drainAndClose(resp.Body)
+			return nil, errors.New("jobtrack: mutation redirect refused")
+		}
+		return resp, nil
+	}
+
 	replayable, err := ensureReplayableBody(req)
 	if err != nil {
 		return nil, err
