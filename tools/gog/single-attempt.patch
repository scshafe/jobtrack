diff --git a/internal/googleapi/jobtrack_single_attempt_test.go b/internal/googleapi/jobtrack_single_attempt_test.go
new file mode 100644
index 0000000..b5b8d0a
--- /dev/null
+++ b/internal/googleapi/jobtrack_single_attempt_test.go
@@ -0,0 +1,162 @@
+package googleapi
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"golang.org/x/oauth2"
+	"google.golang.org/api/gmail/v1"
+	"google.golang.org/api/option"
+)
+
+type jobtrackRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f jobtrackRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestJobTrackPhysicalMutationSingleAttempt(t *testing.T) {
+	for _, code := range []int{200, 401, 429, 500, 502, 503} {
+		t.Run(fmt.Sprint(code), func(t *testing.T) {
+			var physical atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodPost {
+					t.Errorf("method = %s", r.Method)
+				}
+				body, _ := io.ReadAll(r.Body)
+				if len(body) == 0 {
+					t.Error("empty mutation body")
+				}
+				physical.Add(1) // The provider commits before reporting an error.
+				w.WriteHeader(code)
+				_, _ = io.WriteString(w, `{ "id": "native-id", "message": {"id": "native-message"} }`)
+			}))
+			defer server.Close()
+			transport := NewRetryTransport(&oauth2.Transport{
+				Source: oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "test-only-not-a-credential"}),
+				Base:   http.DefaultTransport,
+			})
+			client := &http.Client{Transport: transport}
+			svc, err := gmail.NewService(t.Context(), option.WithHTTPClient(client), option.WithEndpoint(server.URL+"/"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = svc.Users.Drafts.Create("me", &gmail.Draft{Message: &gmail.Message{Raw: "dGVzdA"}}).Do()
+			if code == 200 && err != nil {
+				t.Fatal(err)
+			}
+			if code != 200 && err == nil {
+				t.Fatal("expected provider rejection")
+			}
+			if got := physical.Load(); got != 1 {
+				t.Fatalf("physical draft creates = %d, want 1", got)
+			}
+			physical.Store(0)
+			_, err = svc.Users.Messages.Send("me", &gmail.Message{Raw: "dGVzdA"}).Do()
+			if code == 200 && err != nil {
+				t.Fatal(err)
+			}
+			if code != 200 && err == nil {
+				t.Fatal("expected provider rejection")
+			}
+			if got := physical.Load(); got != 1 {
+				t.Fatalf("physical sends = %d, want 1", got)
+			}
+		})
+	}
+}
+
+func TestJobTrackMutationRefusesRedirectBeforeClientReplay(t *testing.T) {
+	for _, code := range []int{301, 302, 303, 307, 308} {
+		t.Run(fmt.Sprint(code), func(t *testing.T) {
+			var original, destination atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/destination" {
+					destination.Add(1)
+					return
+				}
+				original.Add(1)
+				w.Header().Set("Location", "/destination")
+				w.WriteHeader(code)
+			}))
+			defer server.Close()
+			req, _ := http.NewRequest(http.MethodPost, server.URL+"/create", strings.NewReader("committed mutation"))
+			if req.GetBody == nil {
+				t.Fatal("test requires replayable initial request")
+			}
+			client := &http.Client{Transport: NewRetryTransport(http.DefaultTransport)}
+			resp, err := client.Do(req)
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if err == nil {
+				t.Fatal("mutation redirect must fail closed")
+			}
+			if original.Load() != 1 || destination.Load() != 0 {
+				t.Fatalf("requests original=%d destination=%d", original.Load(), destination.Load())
+			}
+		})
+	}
+}
+
+func TestJobTrackMutationRemovesReplayHooksAndRejectsHeaders(t *testing.T) {
+	for _, method := range []string{"POST", "PUT", "PATCH", "DELETE", "post"} {
+		req, _ := http.NewRequest(method, "https://example.invalid/", bytes.NewBufferString("mutation"))
+		base := jobtrackRoundTripper(func(r *http.Request) (*http.Response, error) {
+			if r.GetBody != nil {
+				t.Fatal("unsafe request retains GetBody")
+			}
+			body, _ := io.ReadAll(r.Body)
+			if string(body) != "mutation" {
+				t.Fatal("body altered")
+			}
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("ok"))}, nil
+		})
+		resp, err := NewRetryTransport(base).RoundTrip(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+	}
+	for _, name := range []string{"Idempotency-Key", "X-Idempotency-Key", "idempotency-key", "x-idempotency-key"} {
+		req, _ := http.NewRequest(http.MethodPost, "https://example.invalid/", bytes.NewBufferString("mutation"))
+		req.Header[name] = []string{""}
+		base := jobtrackRoundTripper(func(r *http.Request) (*http.Response, error) {
+			t.Fatal("unsafe replay header reached network")
+			return nil, nil
+		})
+		if _, err := NewRetryTransport(base).RoundTrip(req); err == nil {
+			t.Fatal("expected replay header rejection")
+		}
+	}
+}
+
+func TestJobTrackMutationDisconnectAfterCommitIsNotReplayed(t *testing.T) {
+	var physical atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.ReadAll(r.Body)
+		physical.Add(1)
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		_ = conn.Close()
+	}))
+	defer server.Close()
+	client := &http.Client{Transport: NewRetryTransport(http.DefaultTransport)}
+	resp, err := client.Post(server.URL, "application/json", strings.NewReader(`{"commit":true}`))
+	if resp != nil {
+		resp.Body.Close()
+	}
+	if err == nil {
+		t.Fatal("expected missing acknowledgement")
+	}
+	if physical.Load() != 1 {
+		t.Fatalf("physical commits = %d", physical.Load())
+	}
+}
