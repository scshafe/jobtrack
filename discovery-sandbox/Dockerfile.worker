FROM node:22.23.4-bookworm-slim@sha256:5991875dfb80938dd8a6ba3fe3e96fd04929e70792762b3319d8caadbbe229bc

WORKDIR /app

ENV NODE_ENV=production \
    HOME=/nonexistent \
    NODE_OPTIONS=--disable-proto=throw

COPY --chmod=0444 bounded-io.js contracts.js built-in-parsers.js controller.js strategy-worker.js ./

USER 65532:65532

ENTRYPOINT ["node", "/app/strategy-worker.js"]
