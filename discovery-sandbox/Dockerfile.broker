FROM node:22.23.4-bookworm-slim@sha256:5991875dfb80938dd8a6ba3fe3e96fd04929e70792762b3319d8caadbbe229bc

WORKDIR /app

ENV NODE_ENV=production \
    HOME=/nonexistent \
    NODE_OPTIONS=--disable-proto=throw

COPY --chmod=0444 bounded-io.js contracts.js network-policy.js egress-broker.js broker-cli.js ./

USER 65532:65532
EXPOSE 8787

ENTRYPOINT ["node", "/app/broker-cli.js"]
CMD ["serve", "--policy", "/run/config/discovery-policy.json", "--host", "0.0.0.0", "--port", "8787"]
