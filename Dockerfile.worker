# The JobTrack write side as a container: the fabric daemon and its hourly
# heartbeat (docs/move-write-side-to-lubuntu.md). Built by infra's
# `stack deploy jobtrack` from the same commit as the web image, as
# DEPLOY_EXTRA_IMAGES `worker` (image jobtrack-web-worker:<sha>), and only
# while the stack's compose profile `worker` is active. Two services run it:
#   jobtrack-worker     scripts/fabric-worker-service.sh (the entrypoint):
#                       `fabric daemon` -> `fabric dispatch --notify`
#   jobtrack-heartbeat  scripts/fabric-heartbeat.sh: hourly tick + queue.md
#
# Unlike the web image this one is a WRITER and stages Codex workers, so it
# keeps lib/draft-runner and vendor/ (the engine-backed worker runner needs
# both) and carries the Codex CLI. It carries no Gmail credential and no gog
# binary (Gmail is a later phase), and no Docker client (renders are a later
# phase: JOBTRACK_RENDERER=off below).
FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS worker

ARG JOBTRACK_VERSION=2.0.0
ARG JOBTRACK_REVISION=unknown
# The Codex CLI. 0.160.0 (2026-10-04): 0.152.1, the Mini's version, is too old
# for the worker's model (gpt-6-astra: "requires a newer version of Codex").
ARG CODEX_VERSION=0.160.0

LABEL org.opencontainers.image.title="JobTrack Worker" \
      org.opencontainers.image.version="${JOBTRACK_VERSION}" \
      org.opencontainers.image.revision="${JOBTRACK_REVISION}"

# Tools a Codex worker's shell reaches for when it reads a public posting or
# the employer's site (the briefs allow GETs, never submissions), plus the CA
# bundle the slim base lacks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq python3 ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global --no-audit --no-fund "@openai/codex@${CODEX_VERSION}" \
    && codex --version

WORKDIR /app

ENV NODE_ENV=production \
    JOBTRACK_HOME=/jobtrack \
    JOBTRACK_NODE_PATH=/usr/local/bin/node \
    CODEX_HOME=/codex-home \
    HOME=/tmp \
    JOBTRACK_RENDERER=off

COPY package*.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev --no-audit --no-fund

COPY bin ./bin
COPY lib ./lib
COPY contracts ./contracts
COPY discovery-sandbox ./discovery-sandbox
COPY scripts ./scripts
COPY skill ./skill
COPY deploy/worker ./deploy/worker
# The codex executor checks that the scoped gog route (tools/gog/umich-bin) is
# owned by the process user and not group/world-writable before it spawns ANY
# worker (scripts/lib/gog-environment.cjs), so this tree belongs to the runtime
# uid, 1000 (the store owner on the production laptop). The route itself fails
# closed on Linux: the pinned gog build is darwin-arm64 only.
COPY --chown=1000:1000 tools ./tools

# Readable by any runtime uid, writable by none but root and the tools/ owner;
# the root filesystem is read-only at run time anyway.
RUN chmod -R a+rX,go-w /app

USER 1000:1000

ENTRYPOINT ["/bin/sh", "/app/scripts/fabric-worker-service.sh"]
