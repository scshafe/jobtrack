{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execution-contracts.local/email/job-application-email-facts.v1.schema.json",
  "title": "Job application email facts v1",
  "description": "PROMOTED verbatim from JobTrack contracts/email/job-application-email-facts.v1.schema.json (the ACCEPTOR). Inbox's live producer (src/integration/jobtrack-relay-contracts.ts) emits a STRICT SUBSET of this shape: it always sets contentCompleteness=sanitized_plain_text, replyRequested=false, empty postingRefs/applicationRefs, extraction.provider=inbox-pipeline / extraction.version=jobtrack-relay.v2, security={risk:medium,requiresReview:true}, and never emits company/interview/requestedAction. This promoted schema keeps the acceptor's full breadth so the cross-repo test (test/jobtrack-facts-projection.test.ts) passes unchanged. NOTE: JobTrack's lib/email-contracts.js adds code-side cross-field rules NOT expressible here (fromDomain must equal fromAddress domain; interview_* eventKinds require a matching interview.intent). Consumers must run both the JSON Schema AND those code checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trust",
    "source",
    "contentCompleteness",
    "eventKind",
    "postingRefs",
    "applicationRefs",
    "replyRequested",
    "evidence",
    "extraction",
    "security"
  ],
  "properties": {
    "schemaVersion": { "const": "job-application-email-facts.v1" },
    "trust": { "const": "untrusted_external" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "accountId", "messageId", "threadId", "receivedAt", "fromAddress", "fromDomain", "contentDigest"],
      "properties": {
        "provider": { "enum": ["gmail", "fixture", "manual"] },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 320 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "receivedAt": { "type": "string", "format": "date-time" },
        "fromAddress": { "type": "string", "format": "email", "maxLength": 320 },
        "fromDomain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "replyToAddress": { "type": "string", "format": "email", "maxLength": 320 },
        "contentDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "contentCompleteness": { "enum": ["metadata_only", "sanitized_plain_text"] },
    "eventKind": {
      "enum": [
        "application_received",
        "action_required",
        "interview_invite",
        "interview_rescheduled",
        "interview_cancelled",
        "rejection",
        "offer",
        "withdrawal_confirmed",
        "recruiter_followup",
        "unknown"
      ]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 253 }
      },
      "anyOf": [{ "required": ["name"] }, { "required": ["domain"] }]
    },
    "postingRefs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2000 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "externalJobId": { "type": "string", "minLength": 1, "maxLength": 300 },
          "roleTitle": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "anyOf": [
          { "required": ["url"] },
          { "required": ["externalJobId"] },
          { "required": ["roleTitle"] }
        ]
      }
    },
    "applicationRefs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "value"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1, "maxLength": 100 },
          "value": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "interview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": { "enum": ["schedule", "reschedule", "cancel", "reminder", "outcome", "unknown"] },
        "round": { "enum": ["screen", "technical", "onsite", "final", "other"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "previousScheduledAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "format": { "enum": ["phone", "video", "onsite", "unknown"] },
        "interviewer": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "requestedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["reply", "schedule", "complete_assessment", "provide_information", "review_offer", "other"] },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "replyRequested": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "excerpt"],
        "properties": {
          "field": { "enum": ["from", "subject", "body", "url", "header"] },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version", "confidence"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "requiresReview"],
      "properties": {
        "risk": { "enum": ["low", "medium", "high"] },
        "requiresReview": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
