{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execution-contracts.local/email/email-approved-content.v1.schema.json",
  "title": "Provider-neutral approved email content v1",
  "description": "Logical email content presented for human approval on the provider-neutral content-equivalent lane. Its canonical-JSON digest is the approvedContentDigest carried by approval-receipt.v2 and every downstream request/receipt. The digest binds generation, manifest, provider account, effective recipient, reply thread, subject, body, and reply headers without claiming provider-rendered MIME byte equality. This artifact grants no send authority by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "normalizationVersion",
    "contentId",
    "generationId",
    "manifestDigest",
    "provider",
    "accountId",
    "recipient",
    "thread",
    "subject",
    "body",
    "attachments",
    "sendFidelity",
    "requiresHumanApproval",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "email-approved-content.v1" },
    "normalizationVersion": {
      "description": "Normative text preparation used before display, comparison, and digest: Unicode NFC for subject, body, addresses, and message references; CRLF/lone-CR to LF for body before NFC.",
      "const": "email-text-nfc-lf.v1"
    },
    "contentId": { "$ref": "#/$defs/identifier" },
    "generationId": { "$ref": "#/$defs/identifier" },
    "manifestDigest": {
      "description": "Digest of the immutable release manifest whose code renders and sends this content.",
      "$ref": "#/$defs/sha256"
    },
    "provider": { "$ref": "#/$defs/providerCode" },
    "accountId": { "$ref": "#/$defs/accountId" },
    "recipient": { "$ref": "#/$defs/emailAddress" },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "inReplyTo", "references"],
      "properties": {
        "threadId": { "$ref": "#/$defs/threadId" },
        "inReplyTo": { "$ref": "#/$defs/messageReference" },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/messageReference" }
        }
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 998,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "text", "digest"],
      "properties": {
        "mediaType": { "const": "text/plain" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "digest": {
          "description": "SHA-256 of the normalized UTF-8 body text (email-text-nfc-lf.v1), without JSON quoting or canonicalization.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attachments": {
      "description": "The first provider-neutral send release does not admit attachments.",
      "type": "array",
      "maxItems": 0
    },
    "sendFidelity": { "const": "content_equivalent" },
    "requiresHumanApproval": { "const": true },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
    "providerCode": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "accountId": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
    "emailAddress": { "type": "string", "format": "email", "maxLength": 320 },
    "threadId": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
    "messageReference": { "type": "string", "minLength": 1, "maxLength": 998, "pattern": "^[^\\r\\n]+$" }
  }
}
