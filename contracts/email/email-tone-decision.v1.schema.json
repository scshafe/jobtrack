{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobtrack.local/contracts/email-tone-decision.v1.schema.json",
  "title": "Recipient-aware email tone decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decisionId", "source", "factsDigest", "purpose", "voiceRevisionId",
    "voiceRevisionDigest", "selected", "policy", "rationaleCodes", "generatedBy",
    "sourceStateSha256", "requiresReview"
  ],
  "properties": {
    "schemaVersion": { "const": "email-tone-decision.v1" },
    "decisionId": { "$ref": "#/$defs/identifier" },
    "source": { "$ref": "#/$defs/messageSource" },
    "factsDigest": { "$ref": "#/$defs/sha256" },
    "purpose": { "enum": ["acknowledgement", "scheduling", "information_response", "follow_up", "other"] },
    "styleProfileId": { "$ref": "#/$defs/identifier" },
    "styleProfileDigest": { "$ref": "#/$defs/sha256" },
    "voiceRevisionId": { "$ref": "#/$defs/identifier" },
    "voiceRevisionDigest": { "$ref": "#/$defs/sha256" },
    "selected": {
      "type": "object", "additionalProperties": false,
      "required": ["dimensions", "delivery"],
      "properties": {
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "delivery": { "$ref": "#/$defs/delivery" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "version", "fallback", "maxBandShift", "registerAdaptationOnly",
        "sensitiveTraitInference", "personalityInference", "distinctivePhraseReuse"
      ],
      "properties": {
        "version": { "const": "register-adaptation.v1" },
        "fallback": { "const": "neutral_professional" },
        "maxBandShift": { "enum": [0, 1] },
        "registerAdaptationOnly": { "const": true },
        "sensitiveTraitInference": { "const": false },
        "personalityInference": { "const": false },
        "distinctivePhraseReuse": { "const": false }
      }
    },
    "rationaleCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "enum": [
          "cole_voice_baseline", "thread_register", "reviewed_contact_register", "low_confidence_fallback",
          "scheduling_clarity", "information_clarity", "follow_up_brevity", "conservative_context",
          "identity_mimicry_guard"
        ]
      }
    },
    "generatedBy": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "version", "policyVersion"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "policyVersion": { "const": "register-adaptation.v1" }
      }
    },
    "sourceStateSha256": { "$ref": "#/$defs/sha256" },
    "requiresReview": { "const": true }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "messageSource": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "accountId", "messageId", "threadId"],
      "properties": {
        "provider": { "enum": ["gmail", "fixture", "manual"] },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 320 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["formality", "warmth", "energy", "directness", "verbosity"],
      "properties": {
        "formality": { "enum": ["casual", "neutral", "formal"] },
        "warmth": { "enum": ["reserved", "neutral", "warm"] },
        "energy": { "enum": ["restrained", "neutral", "upbeat"] },
        "directness": { "enum": ["direct", "balanced", "contextual"] },
        "verbosity": { "enum": ["terse", "concise", "moderate"] }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["greeting", "closing", "exclamationPolicy", "emojiPolicy", "contractions"],
      "properties": {
        "greeting": { "enum": ["omit", "name", "hi", "hello", "dear"] },
        "closing": { "enum": ["none", "thanks", "best", "regards"] },
        "exclamationPolicy": { "enum": ["none", "at_most_one"] },
        "emojiPolicy": { "const": "none" },
        "contractions": { "enum": ["avoid", "allow"] }
      }
    }
  }
}
