{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobtrack.local/contracts/jobtrack-correlation-result.v3.schema.json",
  "title": "JobTrack email correlation result v3 (local copy)",
  "description": "JobTrack-local address for the policy-stamped execution-contracts v1.7.0 correlation result. The structural schema is vendored unchanged; JobTrack's validator additionally enforces linked/resolved/candidate, policy-aware automatic eligibility, identity, preferred-candidate, and clarification invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "factsDigest", "policyRevisionId", "identity", "resolution", "candidates", "evidence", "automaticEligible", "clarifiable"],
  "properties": {
    "schemaVersion": { "const": "jobtrack-correlation-result.v3" },
    "source": { "$ref": "#/$defs/messageRef" },
    "factsDigest": { "$ref": "#/$defs/sha256" },
    "policyRevisionId": { "$ref": "#/$defs/positiveId" },
    "identity": { "$ref": "#/$defs/identity" },
    "resolution": { "enum": ["linked", "ambiguous", "unmatched"] },
    "resolved": { "$ref": "#/$defs/candidate" },
    "preferredCandidateId": {
      "description": "The preferred application's id. When present it equals one candidates[].applicationId; Candidate tuples have no separate durable candidate id.",
      "$ref": "#/$defs/positiveId"
    },
    "candidates": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/candidate" } },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
          "value": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "automaticEligible": { "type": "boolean" },
    "clarifiable": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positiveId": { "type": "integer", "minimum": 1 },
    "messageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "accountId", "messageId", "threadId"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 320 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companyIds", "basis", "confidence"],
      "properties": {
        "companyIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/positiveId" }
        },
        "basis": { "enum": ["contact", "domain", "mention", "none"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "applicationVersion", "matchBasis", "confidence", "reasons"],
      "properties": {
        "applicationId": { "$ref": "#/$defs/positiveId" },
        "applicationVersion": { "type": "integer", "minimum": 0 },
        "companyId": { "$ref": "#/$defs/positiveId" },
        "openingId": { "$ref": "#/$defs/positiveId" },
        "postingId": { "$ref": "#/$defs/positiveId" },
        "postingOccurrenceId": { "$ref": "#/$defs/positiveId" },
        "interviewId": { "$ref": "#/$defs/positiveId" },
        "matchBasis": {
          "enum": [
            "provider_application_id",
            "previously_linked_message",
            "previously_linked_thread",
            "exact_posting_occurrence",
            "exact_posting_url",
            "company_and_role",
            "company_domain",
            "company_only",
            "fuzzy",
            "sender_contact",
            "company_mention",
            "body_role_title",
            "company_single_open",
            "clarification_reply"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    }
  }
}
