{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobtrack.local/contracts/application-strategy-routing-policy.v1.schema.json",
  "title": "Application strategy routing policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "version",
    "coordinator",
    "rules",
    "forbiddenEffects"
  ],
  "properties": {
    "schemaVersion": { "const": "application-strategy-routing-policy.v1" },
    "policyId": { "$ref": "#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "requiredModelClass", "routeAlias"],
      "properties": {
        "capability": { "const": "application-strategy" },
        "requiredModelClass": { "const": "frontier" },
        "routeAlias": { "$ref": "#/$defs/routeAlias" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/rule" }
    },
    "forbiddenEffects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["execute", "send-email", "submit-application", "external-mutation"]
      },
      "allOf": [
        { "contains": { "const": "execute" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "send-email" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "submit-application" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "external-mutation" }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "routeAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "capability": {
      "enum": [
        "application-strategy",
        "application-reconcile",
        "company-research",
        "job-posting-analysis",
        "email-signal-analysis",
        "email-tone-analysis",
        "email-draft",
        "application-material-draft",
        "interview-prep",
        "latex-render"
      ]
    },
    "modelClass": {
      "enum": ["deterministic", "economy", "strong", "frontier"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputTokens", "maxOutputTokens", "maxCostMicros", "maxDurationMs"],
      "properties": {
        "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxCostMicros": { "type": "integer", "minimum": 0, "maximum": 100000000000 },
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "defaultRouteAlias",
        "minimumModelClass",
        "escalationModelClass",
        "maxAttempts",
        "reviewMode",
        "budgets"
      ],
      "properties": {
        "capability": { "$ref": "#/$defs/capability" },
        "defaultRouteAlias": { "$ref": "#/$defs/routeAlias" },
        "minimumModelClass": { "$ref": "#/$defs/modelClass" },
        "escalationModelClass": { "$ref": "#/$defs/modelClass" },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "reviewMode": { "enum": ["frontier", "human", "domain"] },
        "budgets": { "$ref": "#/$defs/budgets" }
      }
    }
  }
}
