{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobtrack.local/contracts/application-strategy-plan.v1.schema.json",
  "title": "Application strategy plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trust",
    "applicationId",
    "sourceStateSha256",
    "coordinator",
    "objective",
    "thesis",
    "assumptions",
    "risks",
    "stopConditions",
    "workItems"
  ],
  "properties": {
    "schemaVersion": { "const": "application-strategy-plan.v1" },
    "trust": { "const": "model_proposal" },
    "applicationId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sourceStateSha256": { "$ref": "#/$defs/sha256" },
    "coordinator": { "$ref": "#/$defs/coordinator" },
    "objective": { "$ref": "#/$defs/longText" },
    "thesis": { "$ref": "#/$defs/longText" },
    "assumptions": { "$ref": "#/$defs/boundedStatements" },
    "risks": { "$ref": "#/$defs/boundedStatements" },
    "stopConditions": { "$ref": "#/$defs/boundedStatements" },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/workItem" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "workKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "routeAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nonblankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "pattern": "\\S"
    },
    "boundedStatements": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/nonblankText" }
    },
    "capability": {
      "enum": [
        "application-strategy",
        "application-reconcile",
        "company-research",
        "job-posting-analysis",
        "email-signal-analysis",
        "email-tone-analysis",
        "email-draft",
        "application-material-draft",
        "interview-prep",
        "latex-render"
      ]
    },
    "outputKind": {
      "enum": [
        "analysis",
        "research-proposal",
        "assessment-proposal",
        "email-reply-draft-proposal",
        "application-material-draft-proposal",
        "interview-prep-proposal",
        "render-result"
      ]
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "routeAlias", "modelClass", "provider", "model"],
      "properties": {
        "runId": { "$ref": "#/$defs/identifier" },
        "routeAlias": { "$ref": "#/$defs/routeAlias" },
        "modelClass": { "const": "frontier" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "capability",
        "title",
        "goal",
        "priority",
        "dependsOn",
        "acceptanceCriteria",
        "sourceRefs",
        "outputKind",
        "reviewGate"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/workKey" },
        "capability": { "$ref": "#/$defs/capability" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "dependsOn": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workKey" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/nonblankText" }
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "outputKind": { "$ref": "#/$defs/outputKind" },
        "reviewGate": { "enum": ["frontier", "human", "domain"] }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": [
            "artifact",
            "snapshot",
            "material-revision",
            "email-message",
            "interview",
            "profile-entry",
            "story-use"
          ]
        },
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
